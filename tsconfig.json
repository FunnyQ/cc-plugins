{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "opencode/**/*.ts"],
  "exclude": [
    "packages/clawd/**",
    "packages/monitor/hooks/**",
    "packages/guard/hooks/register.ts",
    "packages/guard/hooks/*.mod.test.ts"
  ]
}
